# ============================================================
# Nate Audio - Jekyll Dependencies
# ============================================================
#
# Bundler reads this file to determine which Ruby packages
# ("gems") are required to build and preview the website.
#
# Nate Audio uses modern Jekyll directly rather than the older
# "github-pages" compatibility gem. This lets the local build
# use a current Jekyll release with our current Ruby runtime.
# ============================================================

source "https://rubygems.org"

# Jekyll builds the Markdown, Liquid templates, layouts, and
# blog posts into the finished static website.
gem "jekyll", "~> 4.4"

# Generates the site's feed and matches the plugin enabled in
# _config.yml.
gem "jekyll-feed", "~> 0.17"

# Ruby has progressively moved some former standard-library
# components into standalone gems. Declaring these explicitly
# keeps the development environment predictable.
gem "logger"
gem "webrick"